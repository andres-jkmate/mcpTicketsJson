{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "sourceMap": true,
    // Los paquetes del monorepo se resuelven a su código fuente (condición "@mcp-jkmate/source" de sus exports).
    // En el build, las project references reemplazan ese fuente por el .d.ts compilado.
    "customConditions": ["@mcp-jkmate/source"]
  }
}

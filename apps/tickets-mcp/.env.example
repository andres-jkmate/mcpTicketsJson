# Solo para correr el servidor o los tests desde la terminal.
# Claude Desktop no lee este archivo: las variables van en claude_desktop_config.json (ver README).

# COD_USUARIO de JKMate de quien usa el servidor (identidad de todas las invocaciones)
MCP_COD_USUARIO=15169
# Zona en la que Firebird guarda los TIMESTAMP (no tienen zona propia)
ZONA_HORARIA_BASE=America/Argentina/Buenos_Aires

# Logging (Pino a stderr y, si hay SEQ_URL, también a Seq)
LOG_LEVEL=info
SEQ_URL=
SEQ_API_KEY=

# Base de tickets (Firebird 3)
FIREBIRD_HOST=127.0.0.1
FIREBIRD_PORT=3050
FIREBIRD_DATABASE=E:\Bases\CREAR_JK3_20261016.fdb
FIREBIRD_USER=SYSDBA
FIREBIRD_PASSWORD=
FIREBIRD_POOL_MAX=5

# Medición v1 contra v2 (npm run medir). La v2 se lanza sola por stdio con las variables de arriba.
MEDICION_URL_V1=
MEDICION_TOKEN_V1=

# Medición con agente real (npm run medir:agente). Usa la API de Anthropic y consume tokens.
# Alternativa a la API key: un perfil de `ant auth login`.
# ANTHROPIC_API_KEY=
